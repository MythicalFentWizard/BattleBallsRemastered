<!--
  A password field with a reveal toggle.

  WPF's PasswordBox deliberately will not show its own text, and its Password property
  is not a DependencyProperty, so this holds both a PasswordBox and a TextBox over the
  same value and swaps which one is visible. The two are kept in sync through the
  Password dependency property, which is what the rest of the app binds to.
-->
<UserControl x:Class="Launcher.SecretBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Border x:Name="Shell" Background="{StaticResource Sunken}"
          BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <PasswordBox x:Name="Hidden" Grid.Column="0"
                   Background="Transparent" BorderThickness="0" Padding="9,6"
                   Foreground="{StaticResource Text}" CaretBrush="{StaticResource Accent}"
                   SelectionBrush="{StaticResource Accent}"
                   FontFamily="{StaticResource UiFont}" FontSize="13"
                   VerticalContentAlignment="Center"/>

      <TextBox x:Name="Shown" Grid.Column="0" Visibility="Collapsed"
               Background="Transparent" BorderThickness="0" Padding="9,6"
               Foreground="{StaticResource Text}" CaretBrush="{StaticResource Accent}"
               SelectionBrush="{StaticResource Accent}"
               FontFamily="{StaticResource UiFont}" FontSize="13"
               VerticalContentAlignment="Center"/>

      <ToggleButton x:Name="Reveal" Grid.Column="1" Width="32" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Focusable="False"
                    ToolTip="Show password">
        <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="hit" Background="Transparent">
              <Grid>
                <!-- eye outline, always drawn -->
                <Path x:Name="eye" Width="17" Height="17" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{StaticResource Faint}" StrokeThickness="1.5" Fill="Transparent"
                      Data="M 1,8 C 4,3 12,3 15,8 C 12,13 4,13 1,8 Z M 8,6.2
                            A 1.8,1.8 0 1 1 8,9.8 A 1.8,1.8 0 1 1 8,6.2 Z"/>
                <!-- slash, shown only while hidden -->
                <Path x:Name="slash" Width="17" Height="17" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{StaticResource Faint}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 2,14 L 14,2"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="slash" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="eye" Property="Stroke" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="eye" Property="Stroke" Value="{StaticResource Text}"/>
                <Setter TargetName="slash" Property="Stroke" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="hit" Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </ToggleButton.Template>
      </ToggleButton>
    </Grid>
  </Border>
</UserControl>
